# The database Ushabti talks to. The default matches docker-compose.yml.
DATABASE_URL=postgres://ushabti:ushabti@localhost:5435/ushabti

# Only needed for docker-compose.prod.yml, where it becomes the database
# password. Use a long random string.
POSTGRES_PASSWORD=change-me

# Optional. How many connections one Ushabti process may hold. The default is
# 12, which suits a database of its own. Lower it when the database is shared:
# a managed cluster often allows only 25 connections for everything on it.
# Live updates take one more on top, for LISTEN.
# DATABASE_POOL_MAX=5

# Set to "closed" to stop this instance taking new accounts. Anybody who can
# reach the URL can sign up while it is open, and there is no rate limit yet.
# Close it once your team has registered.
# USHABTI_SIGNUP=closed

# Optional. Where the server sends email, and who it is from. Set both and an
# invite to an email with no account, and a reset link made for a member, are
# emailed as well as shown on the page. Set neither and nothing is emailed.
# One without the other keeps mail off, and the server logs why at start.
# smtps:// is TLS from the first byte (usually port 465); smtp:// upgrades with
# STARTTLS (usually 587), and a send fails when STARTTLS is not offered, except to
# localhost. Percent-encode a "@" or ":" in the user or password.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM="Ushabti <board@example.com>"

# Optional. The address your team opens the board at, with https:// and no
# path. With mail on as well, the sign-in page offers "Forgot password?", which
# emails a person a link to set a new password. The link is built from this
# address and never from the request, because anybody can forge the Host a
# request names. With mail on and this unset, the server logs at start that the
# forgot page is off. It is the same USHABTI_URL an agent uses.
# USHABTI_URL=https://tasks.example.com

# Optional. The S3-compatible bucket a task's files live in: DigitalOcean
# Spaces, AWS S3, RustFS. The bucket stays private; a file is read only through
# the board, which checks who asks and redirects to a link that lasts five
# minutes. With no bucket, attachments are off and every attachment route
# answers 503. A bucket without both keys keeps them off, and the server logs
# why at start. S3_ENDPOINT is empty for AWS; S3_FORCE_PATH_STYLE=true is for
# RustFS. The browser uploads straight to the bucket, so give the bucket a CORS
# rule that allows PUT from the board's address.
# S3_ENDPOINT=https://ams3.digitaloceanspaces.com
# S3_REGION=ams3
# S3_BUCKET=ushabti-files
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=false
# The largest file, in bytes (default 50 MiB), and the types a task takes.
# SVG is never shown in place, because it carries script: it downloads.
# ATTACHMENT_MAX_BYTES=52428800
# ATTACHMENT_MIMES=image/png,image/jpeg,image/gif,image/webp,video/mp4,video/webm

# Set to "1" to let a webhook be pointed at a private, loopback or link-local
# address. It is refused by default: a webhook is the one request a person
# tells the server to make for them, and an open one turns the settings page
# into a way to read whatever else is on the network. Set it only when your
# receiver really is on that network.
# USHABTI_WEBHOOK_PRIVATE=1

# Only for `next dev`. The dev server blocks its own live-reload resources for
# any host but localhost, and a page it blocks never comes alive. Name the
# other hosts you reach this machine by, comma separated, without the scheme
# and without the port. Unset, the default stands.
# ALLOWED_DEV_ORIGINS=mini-m4.local,192.168.1.8
