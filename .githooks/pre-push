#!/bin/sh
# Refuses a push that carries a secret. It scans only the commits the push
# adds, so a push stays fast. Turn it on once per clone:
#   git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed, so the push is refused." >&2
  echo "Install it (brew install gitleaks), or push with --no-verify." >&2
  exit 1
fi

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # A deleted branch carries no commits.
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # A new branch: the commits no remote branch has yet.
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  if ! gitleaks git --log-opts="$range" --redact --no-banner --verbose --log-level warn .; then
    echo "pre-push: gitleaks found a secret in $local_ref. Nothing was pushed." >&2
    status=1
  fi
done

exit $status
