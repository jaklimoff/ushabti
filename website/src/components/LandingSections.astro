---
import { Icon } from '@astrojs/starlight/components'
import type { ComponentProps } from 'astro/types'

type IconName = ComponentProps<typeof Icon>['name']

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

const features: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'setting',
    title: 'Custom properties',
    body: 'Select, multi-select, person, text, number, date and checkbox. Create, rename, recolour, reorder and delete any of them — including the ones your project started with.',
  },
  {
    icon: 'list-format',
    title: 'Views',
    body: 'A view is the same tasks grouped by a different property. Group by Status today, by Phase tomorrow, by whoever holds the card after that.',
  },
  {
    icon: 'random',
    title: 'Drag, or never touch the mouse',
    body: 'Cards move within and across columns; column headers reorder the options behind them. One press of Tab reaches the board, and the arrow keys do the rest.',
  },
  {
    icon: 'magnifier',
    title: 'Filters that tell the truth',
    body: 'Every rule has to pass, and “is not” keeps the tasks that hold nothing. A rule pointing at a deleted option stops hiding cards the moment it stops making sense.',
  },
  {
    icon: 'comment',
    title: 'A quiet task panel',
    body: 'Title, markdown description, checklist with progress, comments and an activity log — all edited in place. The board has no dialogs.',
  },
  {
    icon: 'rocket',
    title: 'Live, in about a second',
    body: 'Server-sent events over Postgres LISTEN/NOTIFY. A change by one person reaches every open board with no reload and no polling.',
  },
]
---

<!-- ── Nothing is hardcoded ─────────────────────────────────────────────── -->
<section class="band not-content">
  <p class="eyebrow">The whole idea</p>
  <h2 class="band-title">There is nothing special about Status</h2>
  <p class="band-lede">
    Most boards give you Status and Priority and let you add fields around them. In Ushabti there
    are no fields around anything: <strong>Status is a row you can rename, recolour or delete</strong>,
    exactly like the property you add yourself this afternoon. A view is a board grouped by one of
    them, so the columns are just that property’s options, in the order you dragged them.
  </p>

  <div class="chain">
    <div class="chain-node">
      <span class="chain-kind">property</span>
      <span class="chain-name">Status</span>
      <span class="chain-note">type: select</span>
    </div>
    <span class="chain-arrow" aria-hidden="true">→</span>
    <div class="chain-node">
      <span class="chain-kind">its options</span>
      <span class="chain-opts">
        <em style="--c:#6b7280">Backlog</em>
        <em style="--c:#d1913a">Todo</em>
        <em style="--c:#3fb0c8">In progress</em>
        <em style="--c:#2f9e7a">Done</em>
      </span>
      <span class="chain-note">drag to reorder</span>
    </div>
    <span class="chain-arrow" aria-hidden="true">→</span>
    <div class="chain-node is-out">
      <span class="chain-kind">a view</span>
      <span class="chain-name">Board</span>
      <span class="chain-note">columns = those options</span>
    </div>
  </div>

  <p class="band-foot">
    Delete Status and the board that grouped by it asks you to point it somewhere else. Nothing
    breaks, because nothing was ever built on the name.
  </p>
</section>

<!-- ── Agents ──────────────────────────────────────────────────────────── -->
<section class="band band-split not-content">
  <div>
    <p class="eyebrow">Agents</p>
    <h2 class="band-title">Your ushabti answers</h2>
    <p class="band-lede">
      An agent is a member of the project — a row in <code>users</code> with no password. It signs
      in with a token, uses the <strong>same JSON API the browser uses</strong>, and can be the
      value of any person property, the author of a comment, and an actor in the activity log.
    </p>
    <p class="band-lede">
      While it works, one strip along the bottom of its card says who is working, what they are
      doing and for how long. The plan and the log live in the panel, where they cannot make a
      board of ten runs unreadable.
    </p>
    <p class="band-lede">
      <strong>Pause and Stop are requests, not commands.</strong> The server cannot reach into
      another machine: it writes a word on the run, the agent reads it in the answer to its next
      report, and obeys because it said it would. Only <em>Take over</em> decides anything, because
      that acts on our own database.
    </p>
    <a class="band-link" href={`${base}/agents/`}>
      Read the agent guide <Icon name="right-arrow" size="1em" />
    </a>
  </div>

  <div class="panel" role="img" aria-label="The Agent tab of the task panel during a live run">
    <div class="panel-tabs">
      <span>Comments</span>
      <span>Activity</span>
      <span class="is-on"><i class="panel-tab-dot"></i>Agent</span>
    </div>
    <div class="panel-head">
      <span class="panel-avatar">B<i class="panel-ring"></i></span>
      <span class="panel-agent">Builder</span>
      <span class="panel-state">active</span>
      <span class="panel-age">started 6m ago</span>
    </div>
    <div class="panel-now">
      <i class="panel-now-dot"></i>
      <span>Writing tests/queue.spec.ts</span>
      <span class="panel-count">3 / 4</span>
    </div>
    <div class="panel-bar"><i style="width:50%"></i></div>
    <ol class="panel-plan">
      <li class="is-done"><i></i>Read the queue module</li>
      <li class="is-done"><i></i>Draft the acceptance criteria</li>
      <li class="is-active"><i></i>Write the tests<span>2m</span></li>
      <li><i></i>Report back</li>
    </ol>
    <div class="panel-log">
      <p><span>6m</span> started: write the offline queue tests</p>
      <p><span>4m</span> step 2: draft the acceptance criteria</p>
      <p><span>2m</span> step 3: write tests/queue.spec.ts</p>
    </div>
    <div class="panel-buttons">
      <span>Pause</span><span>Stop</span><span class="is-danger">Take over</span>
    </div>
  </div>
</section>

<!-- ── Features ────────────────────────────────────────────────────────── -->
<section class="band not-content">
  <p class="eyebrow">What you get</p>
  <h2 class="band-title">Small by intent, not by neglect</h2>
  <div class="grid">
    {
      features.map((f) => (
        <article class="tile">
          <Icon name={f.icon} size="1.1rem" class="tile-icon" />
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </article>
      ))
    }
  </div>
</section>

<!-- ── Quickstart ──────────────────────────────────────────────────────── -->
<section class="band band-split band-flip not-content">
  <div class="term">
    <div class="term-bar"><i></i><i></i><i></i><span>zsh</span></div>
    <pre><code><span class="c"># you need Docker. Nothing else.</span>
<span class="p">$</span> git clone https://github.com/jaklimoff/ushabti
<span class="p">$</span> cd ushabti && cp .env.example .env
<span class="p">$</span> docker compose up

<span class="c"># something to look at straight away</span>
<span class="p">$</span> docker compose exec app npm run db:seed
<span class="o">  demo@ushabti.local / ushabti-demo</span>
<span class="o">  agent token: ush_demo_seed_token_not_for_real_use</span>

<span class="c"># watch a machine take a card</span>
<span class="p">$</span> node examples/agent.mjs
<span class="o">  I am Builder on Ushabti roadmap (USH).</span>
<span class="o">  Taking USH-3: Write the offline queue tests</span></code></pre>
  </div>
  <div>
    <p class="eyebrow">Run it</p>
    <h2 class="band-title">One command, and a board with something on it</h2>
    <p class="band-lede">
      The app container installs the packages, writes the schema and starts the dev server on its
      own. The seed adds a filled demo project, two accounts and an agent with a run already open,
      so you can see what a working board actually looks like before you decide anything.
    </p>
    <p class="band-lede">
      Sign in as both accounts in two windows to watch the live updates. When you are ready for
      your team, one more compose file serves the production image behind your own reverse proxy.
    </p>
    <div class="band-actions">
      <a class="btn" href={`${base}/start/run-it/`}>Run it locally</a>
      <a class="btn btn-ghost" href={`${base}/start/self-host/`}>Host it for your team</a>
    </div>
  </div>
</section>

<!-- ── Free ────────────────────────────────────────────────────────────── -->
<section class="band band-quiet not-content">
  <h2 class="band-title">Actually free</h2>
  <p class="band-lede band-centre">
    No seat limit, no locked feature, no trial clock, and no cloud edition waiting at the end of
    the road. MIT licensed, for one person or for twenty, today and later.
  </p>
  <div class="band-actions band-centre">
    <a class="btn" href={`${base}/start/what-it-is/`}>Start reading</a>
    <a class="btn btn-ghost" href="https://github.com/jaklimoff/ushabti">
      <Icon name="github" size="1em" /> Source on GitHub
    </a>
  </div>
</section>

<style>
  .band {
    max-width: 62rem;
    margin: 0 auto;
    padding: 4.5rem 1rem 0;
  }

  .band-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }

  .eyebrow {
    font-size: var(--sl-text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.11em;
    font-weight: 600;
    color: var(--sl-color-accent);
    margin: 0 0 0.6rem;
  }

  .band-title {
    font-size: var(--sl-text-3xl);
    letter-spacing: -0.028em;
    line-height: 1.15;
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0 0 1rem;
    border: 0;
  }

  .band-lede {
    color: var(--sl-color-gray-2);
    line-height: 1.7;
    margin: 0 0 1rem;
    max-width: 40rem;
  }

  .band-foot {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    margin-top: 1.5rem;
    max-width: 40rem;
  }

  .band-centre {
    margin-inline: auto;
    text-align: center;
  }

  .band-quiet {
    text-align: center;
    padding-bottom: 2rem;
  }

  .band-quiet .band-title {
    font-size: var(--sl-text-2xl);
  }

  .band-link {
    color: var(--sl-color-text-accent);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    text-decoration: none;
  }

  .band-link:hover {
    text-decoration: underline;
  }

  .band-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.4rem;
    justify-content: inherit;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 34px;
    padding: 0 0.9rem;
    border-radius: 8px;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    background: var(--sl-color-accent);
    color: var(--ush-accent-ink);
    border: 1px solid var(--sl-color-accent);
    transition: filter 0.14s ease;
  }

  :root[data-theme='light'] .btn {
    color: #fff;
  }

  .btn:hover {
    filter: brightness(1.08);
  }

  .btn-ghost {
    background: transparent;
    color: var(--sl-color-white);
    border-color: var(--sl-color-hairline-light);
  }

  .btn-ghost:hover {
    border-color: var(--sl-color-accent);
    filter: none;
  }

  /* ── property → options → view ─────────────────────────────────────── */

  .chain {
    display: flex;
    align-items: stretch;
    gap: 0.75rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .chain-node {
    flex: 1 1 14rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 10px;
    background: var(--sl-color-gray-7);
  }

  .chain-node.is-out {
    border-color: color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--sl-color-accent) 7%, var(--sl-color-gray-7));
  }

  .chain-kind {
    font-size: var(--sl-text-2xs);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--sl-color-gray-3);
    font-weight: 600;
  }

  .chain-name {
    font-size: var(--sl-text-lg);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .chain-note {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .chain-opts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .chain-opts em {
    font-style: normal;
    font-size: var(--sl-text-2xs);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    color: var(--c);
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
    background: color-mix(in srgb, var(--c) 12%, transparent);
  }

  .chain-arrow {
    align-self: center;
    color: var(--sl-color-gray-4);
  }

  /* ── the Agent tab ─────────────────────────────────────────────────── */

  .panel {
    background: var(--ush-bg-card);
    border: 1px solid var(--ush-line);
    border-radius: 12px;
    padding: 0.9rem 1rem 1rem;
    color: var(--ush-text);
    font-size: 12.5px;
    line-height: 1.5;
    box-shadow: 0 24px 60px rgb(0 0 0 / 40%);
  }

  .panel-tabs {
    display: flex;
    gap: 1rem;
    border-bottom: 1px solid var(--ush-line);
    padding-bottom: 0.5rem;
    color: var(--ush-muted);
    font-size: 11.5px;
  }

  .panel-tabs .is-on {
    color: var(--ush-text);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .panel-tab-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3fb0c8;
    animation: land-pulse 1.4s ease-in-out infinite;
  }

  .panel-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }

  .panel-avatar {
    position: relative;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: #3fb0c8;
    color: #05242b;
    font-size: 10px;
    font-weight: 700;
    display: grid;
    place-items: center;
    flex: none;
  }

  .panel-ring {
    position: absolute;
    inset: -2px;
    border: 1px solid #3fb0c8;
    border-radius: 6px;
    animation: land-ring 1.8s ease-out infinite;
  }

  .panel-agent {
    font-weight: 600;
  }

  .panel-state {
    color: #3fb0c8;
    font-size: 11px;
  }

  .panel-age {
    margin-inline-start: auto;
    color: var(--ush-faint);
    font-size: 10.5px;
  }

  .panel-now {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.7rem;
    color: var(--ush-muted);
  }

  .panel-now-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3fb0c8;
    animation: land-pulse 1.4s ease-in-out infinite;
    flex: none;
  }

  .panel-count {
    margin-inline-start: auto;
    font-size: 10.5px;
    color: var(--ush-faint);
    font-variant-numeric: tabular-nums;
  }

  .panel-bar {
    height: 2px;
    background: var(--ush-line);
    border-radius: 2px;
    margin: 0.6rem 0 0.7rem;
    overflow: hidden;
  }

  .panel-bar i {
    display: block;
    height: 100%;
    background: #3fb0c8;
  }

  .panel-plan {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 11.5px;
    color: var(--ush-muted);
  }

  .panel-plan li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .panel-plan i {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    border: 1px solid var(--ush-faint);
    flex: none;
  }

  .panel-plan .is-done {
    color: var(--ush-faint);
    text-decoration: line-through;
  }

  .panel-plan .is-done i {
    background: #3fb0c8;
    border-color: #3fb0c8;
  }

  .panel-plan .is-active {
    color: var(--ush-text);
  }

  .panel-plan .is-active i {
    border-color: #3fb0c8;
  }

  .panel-plan span {
    margin-inline-start: auto;
    color: var(--ush-faint);
    font-size: 10.5px;
  }

  .panel-log {
    margin-top: 0.8rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--ush-line);
    font-size: 11px;
    color: var(--ush-muted);
  }

  .panel-log p {
    margin: 0 0 0.2rem;
    display: flex;
    gap: 0.5rem;
  }

  .panel-log span {
    color: var(--ush-faint);
    width: 1.8rem;
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  .panel-buttons {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }

  .panel-buttons span {
    font-size: 11px;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--ush-line);
    border-radius: 6px;
    color: var(--ush-muted);
  }

  .panel-buttons .is-danger {
    margin-inline-start: auto;
    color: #e0574d;
    border-color: rgb(224 87 77 / 35%);
  }

  @keyframes land-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @keyframes land-ring {
    from {
      transform: scale(1);
      opacity: 0.55;
    }
    to {
      transform: scale(1.7);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel-tab-dot,
    .panel-now-dot,
    .panel-ring {
      animation: none;
    }
    .panel-ring {
      opacity: 0.3;
    }
  }

  /* ── features ──────────────────────────────────────────────────────── */

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1px;
    margin-top: 2rem;
    background: var(--sl-color-hairline-light);
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 12px;
    overflow: hidden;
  }

  .tile {
    background: var(--sl-color-bg);
    padding: 1.35rem 1.3rem 1.5rem;
  }

  .tile-icon {
    color: var(--sl-color-accent);
  }

  .tile h3 {
    font-size: var(--sl-text-base);
    font-weight: 600;
    color: var(--sl-color-white);
    margin: 0.5rem 0 0.35rem;
  }

  .tile p {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.65;
  }

  /* ── terminal ──────────────────────────────────────────────────────── */

  .term {
    background: var(--ush-bg);
    border: 1px solid var(--ush-line);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 24px 60px rgb(0 0 0 / 40%);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.75rem;
    background: var(--ush-bg-top);
    border-bottom: 1px solid var(--ush-line);
  }

  .term-bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ush-line);
  }

  .term-bar span {
    margin-inline-start: 0.4rem;
    font-size: 10.5px;
    color: var(--ush-faint);
  }

  .term pre {
    margin: 0;
    padding: 0.9rem 1rem 1.1rem;
    overflow-x: auto;
    font-family: var(--sl-font-mono);
    font-size: 11.5px;
    line-height: 1.75;
    color: #cdd2d9;
  }

  .term .c {
    color: #565c66;
  }

  .term .p {
    color: #3fb0c8;
  }

  .term .o {
    color: #6b7280;
  }

  @media (max-width: 55rem) {
    .band-split {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .band-flip > :first-child {
      order: 2;
    }
    .chain-arrow {
      display: none;
    }
  }
</style>
